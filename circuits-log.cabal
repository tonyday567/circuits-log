cabal-version: 3.0
name: circuits-log
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-log#readme
bug-reports: https://github.com/tonyday567/circuits-log/issues
synopsis: Generic JSONL logs with YAML-frontmattered bodies
description:
  A small library for append-only JSONL logs where each line is an envelope
  carrying an id, timestamp, and a body string. The body is expected to be a
  markdown file with optional YAML frontmatter. Tools are provided for reading,
  rendering, and appending entries.

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-log

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common ghc-options-exe-stanza
  ghc-options:
    -fforce-recomp
    -funbox-strict-fields
    -rtsopts
    -threaded
    -with-rtsopts=-N

common ghc2024-additions
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    RoleAnnotations

common ghc2024-stanza
  if impl(ghc >=9.10)
    default-language:
      GHC2024
  else
    import: ghc2024-additions
    default-language:
      GHC2021

library
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: src
  exposed-modules:
    Circuit.Log

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.12.2 && <0.13,
    circuits-parser >=0.1 && <0.2,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    scientific >=0.3 && <0.4,
    text >=2.1.3 && <2.2,
    time >=1.12 && <1.15,

executable stamp-card
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: stamp-card.hs
  build-depends:
    base >=4.18 && <5,
    circuits-log,
    optparse-applicative >=0.18 && <0.20,
    text >=1.2 && <2.2,
    time >=1.12 && <1.15,
